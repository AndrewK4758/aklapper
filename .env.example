# =============================================================================
# andrew-k.us — Root Environment & Secrets Template (TRACKED)
# Copy to .env (gitignored) and add per-mode overrides in:
#   .env.local | .env.development | .env.test | .env.e2e | .env.ci | .env.staging | .env.production
# Precedence (highest wins):
#   process.env (shell / CI / Cloud Run) > .env.<mode>.local > .env.<mode> > .env.local > .env
# =============================================================================

# --- Database (PostgreSQL 19 + Drizzle ORM) ---
POSTGRES_PORT=5439
POSTGRES_DB=aklapper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5439/aklapper?sslmode=disable
PG_MAX_CONNS=10

# --- Portal & Admin SSR Runtime ---
PORTAL_PORT=4300
ADMIN_PORT=4301
PORTAL_MAINTENANCE_MODE=false
SERVE_PRERENDERED_STATIC=false

# --- Public SEO & Analytics ---
PUBLIC_PORTAL_URL=https://andrew-k.us
PUBLIC_ADMIN_URL=https://admin.andrew-k.us
PUBLIC_ANALYTICS_ENDPOINT=
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GTM_ID=
PUBLIC_GSC_VERIFICATION=

# --- Vector Store (Qdrant) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --- AI & Embeddings ---
AI_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_CHAT_MODEL=inference
LOCAL_LLM_EMBED_MODEL=embeddinggemma

# --- Auth & Privacy ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=andrew-k.us Admin
WEBAUTHN_ORIGIN=http://localhost:4301
INTERNAL_AUTH_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_BOOTSTRAP_TOKEN=
ANALYTICS_DAILY_SALT=dev-only-rotate-daily

# --- Service Ports & Optional BFF Upstream URLs ---
API_AUTH_PORT=4101
API_ANALYTICS_PORT=4102
GO_K8S_WATCH_PORT=8081
GO_CADENCE_DEMO_PORT=8082
GO_AI_ASK_PORT=8083
GO_CONTACT_PORT=8084
GO_CADENCE_ADMIN_PORT=8085
AUTH_API_URL=
ANALYTICS_API_URL=
K8S_WATCH_URL=
CADENCE_DEMO_URL=
AI_ASK_URL=
CONTACT_API_URL=
CADENCE_ADMIN_URL=

# --- GitHub Actions / GCP Secrets & Deployment Targets ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_LOCATION=us-central1
GAR_REPOSITORY=aklapper
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_WIF_SERVICE_ACCOUNT=
GKE_CLUSTER_NAME=
GKE_CLUSTER_LOCATION=
VERTEX_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-embedding-005
CLOUD_RUN_ALLOW_UNAUTH_ADMIN=false
CLOUD_RUN_ALLOW_UNAUTH_APIS=false
