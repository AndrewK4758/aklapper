# =============================================================================
# andrew-k.us v3 — Environment Template (Local Dev & GCP Cheapest Prod)
# Copy to .env (gitignored) and never commit real credentials.
# =============================================================================

# --- Database (PostgreSQL 19 + Drizzle ORM) ---
POSTGRES_PORT=5439
POSTGRES_DB=aklapper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5439/aklapper?sslmode=disable
PG_MAX_CONNS=10

# --- Vector Store (Qdrant) ---
# Local dev: http://127.0.0.1:6333 (docker-compose.dev.yaml)
# Prod (cheapest): Qdrant Cloud 1 GB Forever-Free URL + API key
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --- Agensi Storefront Catalog ---
AGENSI_API_BASE_URL=https://www.agensi.io
AGENSI_API_PATH=/creators/aklapper
AGENSI_CREATOR_HANDLE=aklapper
AGENSI_SYNC_DISABLED=false
AGENSI_API_KEY=
AGENSI_CACHE_TTL_SECONDS=300
AGENSI_FETCH_TIMEOUT_MS=1800

# --- AI & Embeddings ---
# Local dev default uses local llama-swap on :11434
AI_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_CHAT_MODEL=inference
LOCAL_LLM_EMBED_MODEL=embedding

# Production Vertex AI / Gemini (switch AI_PROVIDER=vertex once configured)
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_LOCATION=global
GAR_REPOSITORY=portfolio
VERTEX_MODEL=gemini-3.8-flash
VERTEX_THINKING_LEVEL=LOW
VERTEX_EMBED_MODEL=gemini-embedding-2
# Strictly ignored in production or when AI_PROVIDER=vertex
AI_DEV_UNLIMITED=false
# Optional runtime privacy denylist (single-line JSON array or use AI_PRIVACY_DENYLIST_FILE)
AI_PRIVACY_DENYLIST=
GCP_WIF_SERVICE_ACCOUNT=
GCP_CLOUDRUN_SERVICE_ACCOUNT=
GCP_MIGRATOR_SERVICE_ACCOUNT=
GCP_PG19_VM_SERVICE_ACCOUNT=
IAP_ACCESSOR_EMAIL=

# --- Auth & Privacy ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=andrew-k.us Admin
WEBAUTHN_ORIGIN=http://localhost:4301
INTERNAL_AUTH_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_HANDLE=admin
ADMIN_PASSWORD=
ANALYTICS_DAILY_SALT=dev-only-rotate-daily
# Optional single-line base64-encoded JSON array (or plain JSON array in local dev) of confidential terms to block
DOSSIER_PRIVACY_DENYLIST=

# --- Service Ports & Optional BFF Upstream URLs ---
PORTAL_PORT=4300
ADMIN_PORT=4301
GO_CADENCE_DEMO_PORT=8082
GO_AI_ASK_PORT=8083
GO_AI_ASK_GRPC_PORT=9090
CADENCE_DEMO_URL=
AI_ASK_URL=
