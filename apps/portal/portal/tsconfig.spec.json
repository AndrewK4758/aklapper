{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    "vite.config.ts",
    "react-router.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts",
    ".react-router/types/**/*"
  ],
  "references": [
    {
      "path": "./tsconfig.pages.json"
    },
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
