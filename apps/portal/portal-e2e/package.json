{
  "name": "@aklapper/portal-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@aklapper/db": "workspace:*",
    "@aklapper/tooling": "workspace:*",
    "@playwright/test": "^1.65.1"
  },
  "nx": {
    "name": "portal-e2e",
    "projectType": "application",
    "sourceRoot": "apps/portal/portal-e2e/src",
    "implicitDependencies": [
      "portal"
    ],
    "tags": [
      "scope:e2e",
      "app:portal"
    ],
    "targets": {
      "e2e": {
        "dependsOn": [
          "portal:build"
        ],
        "options": {
          "command": "node --conditions=@aklapper/source ../../../packages/tooling/src/run-with-ephemeral-pg.ts --label e2e -- pnpm exec playwright test"
        }
      },
      "e2e-ci": {
        "dependsOn": [
          "portal:build"
        ]
      }
    }
  }
}
