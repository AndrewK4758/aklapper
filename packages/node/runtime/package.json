{
  "name": "@aklapper/node-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aklapper/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "@aklapper/source": "./src/env.ts",
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "require": "./src/env.ts",
      "default": "./dist/env.js"
    },
    "./ssr": {
      "@aklapper/source": "./src/site-server.ts",
      "types": "./dist/site-server.d.ts",
      "import": "./dist/site-server.js",
      "default": "./dist/site-server.js"
    },
    "./ssr/entry": {
      "@aklapper/source": "./src/entry-server.ts",
      "types": "./dist/entry-server.d.ts",
      "import": "./dist/entry-server.js",
      "default": "./dist/entry-server.js"
    },
    "./ssr/stream": {
      "@aklapper/source": "./src/stream.ts",
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "default": "./dist/stream.js"
    },
    "./ai": {
      "@aklapper/source": "./src/ai.ts",
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    },
    "./agensi": {
      "@aklapper/source": "./src/agensi.ts",
      "types": "./dist/agensi.d.ts",
      "import": "./dist/agensi.js",
      "default": "./dist/agensi.js"
    },
    "./analytics": {
      "@aklapper/source": "./src/analytics.ts",
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js",
      "default": "./dist/analytics.js"
    },
    "./http": {
      "@aklapper/source": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./auth": {
      "@aklapper/source": "./src/auth.ts",
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./privacy": {
      "@aklapper/source": "./src/privacy.ts",
      "types": "./dist/privacy.d.ts",
      "import": "./dist/privacy.js",
      "default": "./dist/privacy.js"
    },
    "./runtime-health": {
      "@aklapper/source": "./src/runtime-health.ts",
      "types": "./dist/runtime-health.d.ts",
      "import": "./dist/runtime-health.js",
      "default": "./dist/runtime-health.js"
    }
  },
  "dependencies": {
    "@aklapper/core": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "isbot": "^5.2.3",
    "maxmind": "^4.3.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.2"
  },
  "nx": {
    "name": "node-runtime",
    "projectType": "library",
    "sourceRoot": "packages/node/runtime/src",
    "tags": [
      "scope:node",
      "runtime:node"
    ]
  }
}
