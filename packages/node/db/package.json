{
  "name": "@aklapper/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aklapper/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "@aklapper/source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./client": {
      "@aklapper/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./seed": {
      "@aklapper/source": "./src/seed.ts",
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js",
      "default": "./dist/seed.js"
    },
    "./migrate": {
      "@aklapper/source": "./src/migrate.ts",
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    },
    "./provision-admin-role": {
      "@aklapper/source": "./src/provision-admin-role.ts",
      "types": "./dist/provision-admin-role.d.ts",
      "import": "./dist/provision-admin-role.js",
      "default": "./dist/provision-admin-role.js"
    },
    "./provision-portal-role": {
      "@aklapper/source": "./src/provision-portal-role.ts",
      "types": "./dist/provision-portal-role.d.ts",
      "import": "./dist/provision-portal-role.js",
      "default": "./dist/provision-portal-role.js"
    },
    "./seed-admin": {
      "@aklapper/source": "./src/seed-admin.ts",
      "types": "./dist/seed-admin.d.ts",
      "import": "./dist/seed-admin.js",
      "default": "./dist/seed-admin.js"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:provision-portal-role": "node --conditions=@aklapper/source ./src/provision-portal-role.ts",
    "db:provision-admin-role": "node --conditions=@aklapper/source ./src/provision-admin-role.ts",
    "db:migrate": "node --conditions=@aklapper/source ./src/migrate.ts",
    "db:seed": "node --conditions=@aklapper/source ./src/seed.ts",
    "db:seed-admin": "node --conditions=@aklapper/source ./src/seed-admin.ts",
    "db:setup": "pnpm run db:provision-portal-role && pnpm run db:provision-admin-role && pnpm run db:migrate && pnpm run db:seed"
  },
  "dependencies": {
    "@aklapper/core": "workspace:*",
    "@aklapper/node-runtime": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "nx": {
    "name": "node-db",
    "projectType": "library",
    "sourceRoot": "packages/node/db/src",
    "tags": [
      "scope:node",
      "runtime:node"
    ],
    "targets": {
      "db-generate": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/node/db",
          "command": "drizzle-kit generate"
        }
      },
      "db-provision-portal-role": {
        "cache": false,
        "defaultConfiguration": "development",
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/node/db",
          "command": "node --conditions=@aklapper/source ./src/provision-portal-role.ts"
        },
        "configurations": {
          "development": {},
          "test": {},
          "e2e": {},
          "ci": {},
          "staging": {},
          "production": {}
        }
      },
      "db-provision-admin-role": {
        "cache": false,
        "defaultConfiguration": "development",
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/node/db",
          "command": "node --conditions=@aklapper/source ./src/provision-admin-role.ts"
        },
        "configurations": {
          "development": {},
          "test": {},
          "e2e": {},
          "ci": {},
          "staging": {},
          "production": {}
        }
      },
      "db-migrate": {
        "cache": false,
        "defaultConfiguration": "development",
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/node/db",
          "command": "node --conditions=@aklapper/source ./src/migrate.ts"
        },
        "configurations": {
          "development": {},
          "test": {},
          "e2e": {},
          "ci": {},
          "staging": {},
          "production": {}
        }
      },
      "db-seed": {
        "cache": false,
        "defaultConfiguration": "development",
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/node/db",
          "command": "node --conditions=@aklapper/source ./src/seed.ts"
        },
        "configurations": {
          "development": {},
          "test": {},
          "e2e": {},
          "ci": {},
          "staging": {},
          "production": {}
        }
      },
      "db-setup": {
        "cache": false,
        "defaultConfiguration": "development",
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/node/db",
          "command": "node --conditions=@aklapper/source ./src/provision-portal-role.ts && node --conditions=@aklapper/source ./src/provision-admin-role.ts && node --conditions=@aklapper/source ./src/migrate.ts && node --conditions=@aklapper/source ./src/seed.ts"
        },
        "configurations": {
          "development": {},
          "test": {},
          "e2e": {},
          "ci": {},
          "staging": {},
          "production": {}
        }
      }
    }
  }
}
