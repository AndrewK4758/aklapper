      "checkConstraints": {
        "contact_name_length_check": {
          "name": "contact_name_length_check",
          "value": "char_length(btrim(\"contact_submissions\".\"name\")) >= 2 AND char_length(btrim(\"contact_submissions\".\"name\")) <= 120"
        },
        "contact_phone_format_check": {
          "name": "contact_phone_format_check",
          "value": "\"contact_submissions\".\"phone\" IS NULL OR (char_length(btrim(\"contact_submissions\".\"phone\")) >= 7 AND char_length(btrim(\"contact_submissions\".\"phone\")) <= 32 AND \"contact_submissions\".\"phone\" ~ '^[0-9+(). -]+$')"
        },
        "contact_email_format_check": {
          "name": "contact_email_format_check",
          "value": "char_length(btrim(\"contact_submissions\".\"email\")) <= 254 AND \"contact_submissions\".\"email\" ~* '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'"
        },
        "contact_message_length_check": {
          "name": "contact_message_length_check",
          "value": "char_length(btrim(\"contact_submissions\".\"message\")) >= 10 AND char_length(btrim(\"contact_submissions\".\"message\")) <= 4000"
        },
        "contact_attachment_consistency_check": {
          "name": "contact_attachment_consistency_check",
          "value": "(\n        \"contact_submissions\".\"attachment_name\" IS NULL\n        AND \"contact_submissions\".\"attachment_mime_type\" IS NULL\n        AND \"contact_submissions\".\"attachment_size_bytes\" IS NULL\n        AND \"contact_submissions\".\"attachment_sha256\" IS NULL\n        AND \"contact_submissions\".\"attachment_content_base64\" IS NULL\n      ) OR (\n        \"contact_submissions\".\"attachment_name\" IS NOT NULL\n        AND char_length(btrim(\"contact_submissions\".\"attachment_name\")) >= 1\n        AND char_length(btrim(\"contact_submissions\".\"attachment_name\")) <= 255\n        AND \"contact_submissions\".\"attachment_mime_type\" IN (\n          'application/pdf',\n          'text/plain',\n          'text/markdown',\n          'image/png',\n          'image/jpeg',\n          'image/webp',\n          'application/json',\n          'text/csv'\n        )\n        AND \"contact_submissions\".\"attachment_size_bytes\" IS NOT NULL\n        AND \"contact_submissions\".\"attachment_size_bytes\" >= 1\n        AND \"contact_submissions\".\"attachment_size_bytes\" <= 5242880\n        AND \"contact_submissions\".\"attachment_sha256\" IS NOT NULL\n        AND \"contact_submissions\".\"attachment_sha256\" ~ '^[a-fA-F0-9]{64}$'\n        AND \"contact_submissions\".\"attachment_content_base64\" IS NOT NULL\n        AND char_length(\"contact_submissions\".\"attachment_content_base64\") >= 1\n      )"
        }
      },
      "isRLSEnabled": false
    },
