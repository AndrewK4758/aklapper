{
  "name": "@aklapper/shared-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aklapper/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./build": {
      "@aklapper/source": "./src/build.ts",
      "types": "./src/build.ts",
      "import": "./src/build.ts",
      "default": "./src/build.ts"
    }
  },
  "dependencies": {
    "@aklapper/contracts": "workspace:*"
  },
  "devDependencies": {
    "@nx/vite": "24.0.6",
    "@react-router/dev": "8.5.2",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.1"
  },
  "nx": {
    "name": "shared-utils",
    "projectType": "library",
    "sourceRoot": "packages/shared/utils/src",
    "tags": [
      "scope:shared",
      "runtime:isomorphic"
    ]
  }
